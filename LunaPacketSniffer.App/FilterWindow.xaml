<Window x:Class="LunaPacketSniffer.App.FilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Filters - LunaPacketSniffer" Width="700" Height="380" MinWidth="600" MinHeight="320"
        Background="#111827" Foreground="#E5E7EB" Icon="LunaPacketSniffer.ico">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#26364F" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#334866" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#182235" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#182235" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#334155" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" ClickMode="Press" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" BorderBrush="{TemplateBinding BorderBrush}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="ComboBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4">
                                            <Grid>
                                                <ContentPresenter Margin="8,0,28,0" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType=ComboBox}}" />
                                                <Path Width="10" Height="6" Margin="0,0,9,0" HorizontalAlignment="Right" VerticalAlignment="Center" Fill="#94A3B8" Data="M 0 0 L 10 0 L 5 6 Z" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ComboBorder" Property="Background" Value="#263B59" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False" IsOpen="{TemplateBinding IsDropDownOpen}">
                                <Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Background="#182235" BorderBrush="#334155" BorderThickness="1" CornerRadius="4" Margin="0,3,0,0">
                                    <ScrollViewer Margin="2">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#182235" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="Padding" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="3" Padding="{TemplateBinding Padding}">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#263B59" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#075985" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Background" Value="#182235" />
            <Setter Property="Foreground" Value="#E5E7EB" />
            <Setter Property="BorderBrush" Value="#334155" />
        </Style>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock FontSize="18" FontWeight="SemiBold">Capture filters</TextBlock>
        <StackPanel Grid.Row="2" Orientation="Horizontal">
            <ComboBox x:Name="FilterTypeComboBox" Width="150" Height="32" SelectedIndex="0" SelectionChanged="FilterTypeComboBox_SelectionChanged">
                <ComboBoxItem Tag="ProcessId">PID</ComboBoxItem>
                <ComboBoxItem Tag="ProcessName">Process Name</ComboBoxItem>
                <ComboBoxItem Tag="ProcessPath">EXE Path</ComboBoxItem>
                <ComboBoxItem Tag="Protocol">Protocol</ComboBoxItem>
            </ComboBox>
            <TextBox x:Name="FilterValueTextBox" Width="200" Height="32" Margin="8,0,0,0" VerticalContentAlignment="Center" />
            <ComboBox x:Name="FilterPidComboBox" Width="300" Height="32" Margin="8,0,0,0" DisplayMemberPath="Display" Visibility="Collapsed" DropDownOpened="FilterPidComboBox_DropDownOpened" />
            <ComboBox x:Name="FilterProtocolComboBox" Width="160" Height="32" Margin="8,0,0,0" Visibility="Collapsed" SelectedIndex="0">
                <ComboBoxItem Tag="TCP">TCP</ComboBoxItem>
                <ComboBoxItem Tag="UDP">UDP</ComboBoxItem>
                <ComboBoxItem Tag="HTTP">HTTP(S)</ComboBoxItem>
            </ComboBox>
            <Button Width="90" Height="32" Margin="8,0,0,0" Click="AddFilterButton_Click">Add filter</Button>
        </StackPanel>
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="110" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="FilterListBox" />
            <Button Grid.Column="2" Height="32" VerticalAlignment="Top" Click="RemoveFilterButton_Click">Remove filter</Button>
        </Grid>
        <TextBlock Grid.Row="5" x:Name="StatusText" Margin="0,10,0,0" Foreground="#38BDF8">Same type: OR / Different types: AND</TextBlock>
    </Grid>
</Window>

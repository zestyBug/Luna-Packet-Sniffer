<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\LunaPacketSniffer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <Resource Include="..\LunaPacketSniffer.ico" Link="LunaPacketSniffer.ico" />
    <ProjectReference Include="..\LunaPacketSniffer.Capture\LunaPacketSniffer.Capture.csproj" />
    <ProjectReference Include="..\LunaPacketSniffer.Persistence\LunaPacketSniffer.Persistence.csproj" />
    <ProjectReference Include="..\LunaPacketSniffer.Protocols\LunaPacketSniffer.Protocols.csproj" />
    <ProjectReference Include="..\LunaPacketSniffer.Proxy\LunaPacketSniffer.Proxy.csproj" />
  </ItemGroup>
  <Target Name="CopyNativeDependencies" AfterTargets="Build">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)\..\artifacts\native\$(Configuration)\LunaPacketSniffer.Native.dll')" Text="Build the native project first with: cmake --preset windows-x64; cmake --build --preset windows-x64-debug" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\artifacts\native\$(Configuration)\LunaPacketSniffer.Native.dll;$(MSBuildProjectDirectory)\..\artifacts\native\$(Configuration)\WinDivert.dll" DestinationFolder="$(TargetDir)" SkipUnchangedFiles="true" />
    <Copy SourceFiles="$(MSBuildProjectDirectory)\..\artifacts\native\$(Configuration)\WinDivert64.sys" DestinationFolder="$(TargetDir)" Condition="!Exists('$(TargetDir)WinDivert64.sys')" />
  </Target>
</Project>

<Window x:Class="LunaPacketSniffer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LunaPacketSniffer" Height="700" Width="1100" MinHeight="400" MinWidth="800">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
            <RowDefinition Height="12" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="FilterTypeComboBox" Width="150" Height="32" SelectedIndex="0" SelectionChanged="FilterTypeComboBox_SelectionChanged">
                    <ComboBoxItem Tag="ProcessId">PID</ComboBoxItem>
                    <ComboBoxItem Tag="ProcessName">Process Name</ComboBoxItem>
                    <ComboBoxItem Tag="ProcessPath">EXE Path</ComboBoxItem>
                    <ComboBoxItem Tag="Protocol">Protocol</ComboBoxItem>
                </ComboBox>
                <TextBox x:Name="FilterValueTextBox" Width="160" Height="32" Margin="8,0,0,0" VerticalContentAlignment="Center" ToolTip="Filter value" />
                <ComboBox x:Name="FilterPidComboBox" Width="260" Height="32" Margin="8,0,0,0" DisplayMemberPath="Display" Visibility="Collapsed" DropDownOpened="FilterPidComboBox_DropDownOpened" />
                <ComboBox x:Name="FilterProtocolComboBox" Width="160" Height="32" Margin="8,0,0,0" Visibility="Collapsed" SelectedIndex="0">
                    <ComboBoxItem Tag="TCP">TCP</ComboBoxItem>
                    <ComboBoxItem Tag="UDP">UDP</ComboBoxItem>
                    <ComboBoxItem Tag="HTTP">HTTP(S)</ComboBoxItem>
                </ComboBox>
                <Button Width="80" Height="32" Margin="8,0,0,0" Click="AddFilterButton_Click">Add filter</Button>
                <Button x:Name="StartButton" Width="100" Height="32" Margin="24,0,0,0" Click="StartButton_Click">Capture</Button>
                <Button x:Name="StopButton" Width="100" Height="32" Margin="8,0,0,0" Click="StopButton_Click" IsEnabled="False">Stop</Button>
                <Button Width="110" Height="32" Margin="24,0,0,0" Click="InstallRootCertificate_Click">Install Root CA</Button>
                <Button Width="110" Height="32" Margin="8,0,0,0" Click="RemoveRootCertificate_Click">Remove Root CA</Button>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <ListBox x:Name="FilterListBox" Width="360" Height="58" SelectionMode="Single" />
                <Button Width="100" Height="32" Margin="8,0,0,0" VerticalAlignment="Top" Click="RemoveFilterButton_Click">Remove filter</Button>
                <ToggleButton x:Name="AutoScrollToggleButton" Width="110" Height="32" Margin="8,0,0,0" VerticalAlignment="Top" IsChecked="True">Auto scroll</ToggleButton>
                <TextBlock Margin="12,6,0,0" Foreground="DimGray">Same type: OR / Different types: AND</TextBlock>
            </StackPanel>
        </StackPanel>
        <TextBlock Grid.Row="2" x:Name="StatusText" FontSize="14">Ready</TextBlock>
        <TabControl Grid.Row="4">
            <TabItem Header="Packets">
                <DataGrid x:Name="PacketGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="PacketGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="180" />
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="90" />
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="150" />
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
                        <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*" />
                        <DataGridTextColumn Header="Destination" Binding="{Binding Destination}" Width="*" />
                        <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="80" />
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="240" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="HTTP(S)">
                <DataGrid x:Name="HttpGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="HttpGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="180" />
                        <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="90" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80" />
                        <DataGridTextColumn Header="URL" Binding="{Binding Url}" Width="*" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding Duration}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="WebSocket">
                <DataGrid x:Name="WebSocketGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="WebSocketGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Time" Binding="{Binding Timestamp}" Width="180" />
                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="100" />
                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100" />
                        <DataGridTextColumn Header="Length" Binding="{Binding Length}" Width="100" />
                        <DataGridTextColumn Header="Summary" Binding="{Binding Summary}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="TCP / UDP Flows">
                <DataGrid x:Name="FlowGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="FlowGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="PID" Binding="{Binding ProcessId}" Width="80" />
                        <DataGridTextColumn Header="Process" Binding="{Binding ProcessName}" Width="160" />
                        <DataGridTextColumn Header="Protocol" Binding="{Binding Protocol}" Width="80" />
                        <DataGridTextColumn Header="Local" Binding="{Binding LocalEndpoint}" Width="*" />
                        <DataGridTextColumn Header="Remote" Binding="{Binding RemoteEndpoint}" Width="*" />
                        <DataGridTextColumn Header="Packets" Binding="{Binding PacketCount}" Width="100" />
                        <DataGridTextColumn Header="Bytes" Binding="{Binding ByteCount}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem Header="KCP">
                <DataGrid x:Name="KcpGrid" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" EnableColumnVirtualization="True" SelectionChanged="KcpGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="conv" Binding="{Binding ConversationId}" Width="100" />
                        <DataGridTextColumn Header="Endpoint A" Binding="{Binding EndpointA}" Width="*" />
                        <DataGridTextColumn Header="Endpoint B" Binding="{Binding EndpointB}" Width="*" />
                        <DataGridTextColumn Header="Segments" Binding="{Binding SegmentCount}" Width="100" />
                        <DataGridTextColumn Header="Messages" Binding="{Binding MessageCount}" Width="100" />
                        <DataGridTextColumn Header="Bytes" Binding="{Binding MessageBytes}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
        <TextBox Grid.Row="6" x:Name="DetailTextBox" Margin="0,8,0,0" IsReadOnly="True" TextWrapping="NoWrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono" />
    </Grid>
</Window>
